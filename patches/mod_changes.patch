+
+        if (curLevel > 4) {
+            return 2;
+        }
+
+        if (curLevel < 6) {
+            return Math.max(0, worldObj.rand.nextInt(2));
+        }
+
+        return Math.max(0, worldObj.rand.nextInt(1));
+    }
