+                int acceptHeight = fullHeight + offset;
+                for(int curY = 0; curY < fullHeight + expandWidth; ++curY) {
+                    if(acceptHeight >= curY
+                            && (isEdge(curX, expandWidth, curZ))) {
+                        if(worldObj.rand.nextInt(4) == 0) {
