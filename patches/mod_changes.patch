+    public int getNumItemsPerLevel(int curLevel) {
+        if (curLevel == 0) {
+            return 3 * 3;
+        }
+
+        if (curLevel < 4) {
+            return 5 * 3;
+        }
+
+        if (curLevel < 8) {
+            return Math.max(0, worldObj.rand.nextInt(14 * 3) - 4);
+        }
+
+        return Math.max(0, worldObj.rand.nextInt(9 * 3) - 2);
+    }
