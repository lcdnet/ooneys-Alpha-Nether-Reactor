+        if (meta == 1) {
+            return this.blockIndexInTexture + 1; // ACTIVATED
+        } else if (meta == 2) {
+            return this.blockIndexInTexture + 2; // DEACTIVATED
+        }
+        return this.blockIndexInTexture; // NORMAL
+    }
