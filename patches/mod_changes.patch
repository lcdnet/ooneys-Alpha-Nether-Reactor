+        float rad = worldObj.rand.nextFloat() * (float) (Math.PI * 2);
+        return  Vec3D.createVectorHelper(Math.sin(rad) * distance + xCoord, offset + yCoord, Math.cos(rad) * distance + zCoord);
+    }
