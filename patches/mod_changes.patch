+        world.setBlockMetadataWithNotify(x, y, z, meta);
+    }
+
+    public static EnumReactorPhase getPhase(World world, int x, int y, int z) {
+        int meta = world.getBlockMetadata(x, y, z);
+        switch (meta) {
